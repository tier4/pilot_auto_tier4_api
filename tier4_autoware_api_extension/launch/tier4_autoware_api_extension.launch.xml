<launch>
  <arg name="use_agnocast" default="$(env ENABLE_AGNOCAST 0)"/>
  <group>
    <push-ros-namespace namespace="tier4_api"/>
    <let name="target" value="$(var ros_namespace)/autoware_iv_adaptor"/>
    <let name="logger" value="$(eval '\'$(var target)\'.strip(\'/\').replace(\'/\', \'.\')')"/>
    <node_container
      pkg="rclcpp_components"
      exec="component_container_mt"
      name="api_extension_container"
      namespace=""
      unless="$(equals $(var use_agnocast) 1)"
      ros_args="--log-level $(var logger):=WARN"
    />

    <autoware_node pkg="tier4_autoware_api_extension" exec="air_condition_node" name="air_condition" target="$(var target)"/>
    <autoware_node pkg="tier4_autoware_api_extension" exec="interior_light_node" name="interior_light" target="$(var target)"/>
    <autoware_node pkg="tier4_autoware_api_extension" exec="route_distance_node" name="route_distance" target="$(var target)"/>
    <autoware_node pkg="tier4_autoware_api_extension" exec="traffic_light_node" name="traffic_light" target="$(var target)"/>
    <autoware_node pkg="tier4_autoware_api_extension" exec="velocity_limit_node" name="velocity_limit" target="$(var target)"/>

    <autoware_node pkg="tier4_autoware_api_extension" exec="planning_factor_node" name="planning_factor" target="$(var target)">
      <param from="$(find-pkg-share tier4_autoware_api_extension)/config/planning_factors.param.yaml"/>
    </autoware_node>

    <autoware_node pkg="autoware_path_distance_calculator" exec="autoware_path_distance_calculator_node" name="path_distance_calculator" namespace="utils" target="$(var target)" output="screen">
      <remap from="~/input/route" to="/planning/mission_planning/route"/>
      <remap from="~/input/map" to="/map/vector_map"/>
      <remap from="~/output/distance" to="~/distance"/>
    </autoware_node>

    <autoware_node pkg="autoware_topic_relay_controller" exec="autoware_topic_relay_controller_node" name="relay_virtual_traffic_light_status" target="$(var target)" output="screen">
      <param name="topic" value="/api/external/set/virtual_traffic_light/states"/>
      <param name="remap_topic" value="/perception/virtual_traffic_light_states"/>
      <param name="topic_type" value="tier4_v2x_msgs/msg/VirtualTrafficLightStateArray"/>
      <param name="enable_relay_control" value="false"/>
      <param name="enable_keep_publishing" value="false"/>
    </autoware_node>

    <autoware_node pkg="autoware_topic_relay_controller" exec="autoware_topic_relay_controller_node" name="relay_virtual_traffic_light_commands" target="$(var target)" output="screen">
      <param name="topic" value="/planning/scenario_planning/status/infrastructure_commands"/>
      <param name="remap_topic" value="/api/external/get/virtual_traffic_light/commands"/>
      <param name="topic_type" value="tier4_v2x_msgs/msg/InfrastructureCommandArray"/>
      <param name="enable_relay_control" value="false"/>
      <param name="enable_keep_publishing" value="false"/>
    </autoware_node>
  </group>
</launch>
