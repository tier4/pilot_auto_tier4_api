<launch>
  <group>
    <push-ros-namespace namespace="tier4_api"/>
    <let name="target" value="$(var ros_namespace)/deprecated_api_container"/>
    <let name="logger" value="$(eval '\'$(var target)\'.strip(\'/\').replace(\'/\', \'.\')')"/>
    <node_container pkg="rclcpp_components" exec="component_container_mt" name="deprecated_api_container" namespace="" ros_args="--log-level $(var logger):=WARN"/>

    <autoware_node pkg="autoware_topic_relay_controller" exec="autoware_topic_relay_controller_node" name="relay_route_distance" target="$(var target)" output="screen">
      <param name="topic" value="/tier4_api/utils/path_distance_calculator/distance"/>
      <param name="remap_topic" value="/autoware_api/utils/path_distance_calculator/distance"/>
      <param name="topic_type" value="autoware_internal_debug_msgs/msg/Float64Stamped"/>
      <param name="enable_relay_control" value="false"/>
      <param name="enable_keep_publishing" value="false"/>
    </autoware_node>

    <!-- For the initial pose API. Some environments cannot handle bounded arrays. -->
    <load_composable_node target="$(var target)">
      <composable_node pkg="tier4_deprecated_api_adapter" plugin="tier4_deprecated_api_adapter::InitialPose" name="initial_pose"/>
    </load_composable_node>

    <!-- For the hazard status API. Waiting for support for the cloud database. -->
    <load_composable_node target="$(var target)">
      <composable_node pkg="tier4_deprecated_api_adapter" plugin="tier4_deprecated_api_adapter::HazardStatus" name="hazard_status"/>
    </load_composable_node>
  </group>
</launch>
