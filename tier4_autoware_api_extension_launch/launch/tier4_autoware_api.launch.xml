<launch>
  <arg name="default_adapi_param_path" default="$(find-pkg-share autoware_default_adapi_universe)/config/default_adapi.param.yaml"/>
  <arg name="launch_api_0_4_3" default="false" description="Launch APIs with an EOL of v0.4.3."/>
  <arg name="launch_api_0_4_4" default="true" description="Launch APIs with an EOL of v0.4.4."/>

  <arg name="scenario_simulation" default="false"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="vehicle_model" default="sample_vehicle"/>

  <arg name="launch_tier4_api" default="true"/>
  <arg name="rosbridge_enabled" default="true"/>
  <arg name="rosbridge_max_message_size" default="1000000000"/>

  <arg name="launch_default_adapi" default="true"/>
  <arg name="launch_rviz_adaptors" default="true"/>

  <arg name="launch_evaluation_adapter" default="$(var scenario_simulation)"/>

  <!-- AD API -->
  <group if="$(var launch_default_adapi)">
    <include file="$(find-pkg-share autoware_default_adapi_universe)/launch/default_adapi.launch.py">
      <arg name="config" value="$(var default_adapi_param_path)"/>
    </include>
  </group>

  <!-- AD API for RViz -->
  <group if="$(var launch_rviz_adaptors)">
    <include file="$(find-pkg-share autoware_adapi_adaptors)/launch/rviz_adaptors.launch.xml"/>
  </group>

  <!-- Evaluation adapter -->
  <group if="$(var launch_evaluation_adapter)">
    <include file="$(find-pkg-share autoware_evaluation_adapter)/launch/evaluation_adapter.launch.xml"/>
  </group>

  <!-- TIER IV -->
  <group if="$(var launch_tier4_api)">
    <include file="$(find-pkg-share tier4_autoware_api_extension_launch)/launch/tier4_autoware_api_extension.launch.xml">
      <arg name="rosbridge_enabled" value="$(var rosbridge_enabled)"/>
      <arg name="rosbridge_max_message_size" value="$(var rosbridge_max_message_size)"/>
      <arg name="launch_api_0_4_3" value="$(var launch_api_0_4_3)"/>
      <arg name="launch_api_0_4_4" value="$(var launch_api_0_4_4)"/>
    </include>
  </group>
</launch>
